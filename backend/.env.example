NODE_ENV=development
DATABASE_URL=postgresql://qayd_app:CHANGE_ME@127.0.0.1:5432/qayd
APP_ORIGIN=http://localhost:8443
PORT=3000
SESSION_HOURS=12
# Leave mail variables unset until a real SMTP service is configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=accounts@example.com
REQUIRE_EMAIL_VERIFICATION=false
